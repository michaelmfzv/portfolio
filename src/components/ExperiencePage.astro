---
import Layout from '../layouts/Layout.astro';
import ExperienceIcon from './ExperienceIcon.astro';
import { experience, site } from '../data/site';
import { localizedPath, ui, type Language } from '../i18n/ui';

interface Props { lang: Language; }
const { lang } = Astro.props;
const t = ui[lang];
const jobs = experience[lang];
const experienceId = (company: string) => company.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
---
<Layout lang={lang} title={`${t.experience} — ${site.name}`} description={t.experienceNote}>
  <article class="section-shell max-w-4xl py-16 sm:py-20">
    <a class="eyebrow" href={localizedPath(lang)}>← {t.navHome}</a>
    <header class="mt-10 max-w-2xl">
      <p class="eyebrow">02 / experience</p>
      <h1 class="mt-3 text-3xl font-semibold tracking-tight sm:text-5xl">{t.experience}</h1>
      <p class="mt-5 text-lg leading-8 text-stone-600 dark:text-stone-300">{t.experienceNote}</p>
    </header>

    <div class="mt-14 space-y-12">
      {jobs.map((job) => <article id={experienceId(job.company)} class="relative scroll-mt-8 border-l border-stone-300 pl-6 dark:border-emerald-900">
        <span class="absolute -left-[5px] top-1.5 h-2.5 w-2.5 rounded-full bg-accent ring-4 ring-paper dark:bg-terminal dark:ring-[#090f0d]" aria-hidden="true"></span>
        <div class="grid grid-cols-[1rem_minmax(0,1fr)] items-start gap-x-3"><div class="pt-1"><ExperienceIcon company={job.company} /></div><div class="min-w-0">
          <div class="flex flex-col justify-between gap-1 sm:flex-row sm:items-baseline sm:gap-4">
            <h2 class="text-xl font-semibold tracking-tight">{job.role}</h2>
            <p class="font-mono text-xs text-stone-500 dark:text-emerald-200/70">{job.period}</p>
          </div>
          <p class="mt-1 text-sm font-medium text-accent dark:text-terminal">{job.company}</p>
          <p class="mt-1 text-xs text-stone-500 dark:text-stone-400">{job.location}</p>
        </div></div>
        <ul class="mt-5 list-disc space-y-2 pl-5 text-sm leading-6 text-stone-600 dark:text-stone-300">
          {job.highlights.map((highlight) => <li>{highlight}</li>)}
        </ul>
      </article>)}
    </div>
  </article>
</Layout>
