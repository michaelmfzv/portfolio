---
interface Props { label: string; }
const { label } = Astro.props;
---
<button
  type="button"
  data-theme-toggle
  aria-label={label}
  title={label}
  class="rounded-md border border-stone-200 p-2 text-stone-700 hover:border-accent hover:text-accent focus:outline-none focus:ring-2 focus:ring-accent dark:border-emerald-950 dark:text-emerald-100 dark:hover:border-terminal dark:hover:text-terminal dark:focus:ring-terminal"
>
  <svg data-sun class="hidden h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42"/></svg>
  <svg data-moon class="hidden h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M20.5 14.2A8.5 8.5 0 0 1 9.8 3.5 8.5 8.5 0 1 0 20.5 14.2Z"/></svg>
</button>

<script>
  const syncThemeButton = () => {
    const dark = document.documentElement.classList.contains('dark');
    document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((button) => {
      button.querySelector('[data-sun]')?.classList.toggle('hidden', !dark);
      button.querySelector('[data-moon]')?.classList.toggle('hidden', dark);
      button.setAttribute('aria-pressed', String(dark));
    });
  };

  document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((button) => {
    button.addEventListener('click', () => {
      const dark = document.documentElement.classList.toggle('dark');
      try { localStorage.setItem('theme', dark ? 'dark' : 'light'); } catch { /* storage may be disabled */ }
      syncThemeButton();
    });
  });
  syncThemeButton();
</script>
