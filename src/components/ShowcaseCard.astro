---
interface Props {
  title: string;
  description: string;
  href?: string;
  cover?: string;
  tags?: string[];
  label?: string;
}
const { title, description, href, cover, tags = [], label } = Astro.props;
---
<article class="surface group overflow-hidden rounded-lg">
  <a href={href ?? '#contact'} class="block" aria-label={`${title}${label ? ` — ${label}` : ''}`}>
    <div class="relative aspect-[16/9] overflow-hidden border-b border-stone-200 bg-[#e9efea] dark:border-emerald-950 dark:bg-[#101c16]">
      {cover ? <img src={cover} alt="" loading="lazy" class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]" /> :
        <div class="flex h-full flex-col justify-between p-5 font-mono text-xs text-stone-500 dark:text-emerald-200/60" aria-hidden="true">
          <span class="flex items-center gap-2"><span class="h-2 w-2 rounded-full bg-emerald-500"></span> infrastructure / architecture</span>
          <pre class="overflow-hidden text-[10px] leading-5 sm:text-xs">{`┌──────────┐     ┌─────────┐
│ workload │ ──▶ │ service │
└────┬─────┘     └────▲────┘
     │                │
     └── observe ─────┘`}</pre>
          <span>01 — technical note</span>
        </div>
      }
    </div>
    <div class="p-5">
      {label && <p class="eyebrow mb-3">{label}</p>}
      <h3 class="text-lg font-semibold tracking-tight group-hover:text-accent dark:group-hover:text-terminal">{title}</h3>
      <p class="mt-2 text-sm leading-6 text-stone-600 dark:text-stone-300">{description}</p>
      {tags.length > 0 && <ul class="mt-4 flex flex-wrap gap-2">{tags.map((tag) => <li class="rounded bg-stone-100 px-2 py-1 font-mono text-[10px] text-stone-600 dark:bg-emerald-950/50 dark:text-emerald-100">{tag}</li>)}</ul>}
    </div>
  </a>
</article>
