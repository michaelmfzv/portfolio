---
interface Props { name: string; }
const { name } = Astro.props;
const iconByTechnology: Record<string, 'kubernetes' | 'docker' | 'proxmox' | 'vmware' | 'gitlab' | 'linux' | 'bash' | 'python' | 'go' | 'podman' | 'ansible' | 'networking'> = {
  Kubernetes: 'kubernetes',
  Docker: 'docker',
  'Proxmox VE': 'proxmox',
  VMware: 'vmware',
  'GitLab CI/CD': 'gitlab',
  Linux: 'linux',
  Bash: 'bash',
  Python: 'python',
  Go: 'go',
  Podman: 'podman',
  Ansible: 'ansible',
  Networking: 'networking',
};
const icon = iconByTechnology[name] ?? 'networking';
---
<span class="inline-flex items-center gap-2 rounded-md border border-stone-200 bg-white px-3 py-2 font-mono text-sm text-stone-700 dark:border-emerald-950 dark:bg-[#0b1410] dark:text-emerald-100">
  <svg class="h-4 w-4 shrink-0 text-accent dark:text-terminal" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    {icon === 'kubernetes' && <g fill="none" stroke="#326ce5" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3.1" fill="#326ce5" stroke="none"/><path d="M12 2.8v4.1M12 17.1v4.1M2.8 12h4.1M17.1 12h4.1M5.5 5.5l2.9 2.9M15.6 15.6l2.9 2.9M18.5 5.5l-2.9 2.9M8.4 15.6l-2.9 2.9"/><circle cx="12" cy="12" r="8.6"/></g>}
    {icon === 'docker' && <g fill="#2496ed" stroke="none"><path d="M3 13.2h1.8V10H8v3.2h1.2V10h3.2v3.2h1.2V10h3.2v3.2h1.7c.4-1.1 1.3-1.7 2.5-1.7.5 0 .9.1 1.3.3-.3 1.4-1.2 2.4-2.7 2.8-.7 4.1-3.9 6.4-8.8 6.4-4.3 0-7.1-2.1-7.8-5.5H3v-2.3Z"/><path d="M5.1 6.2h3.1v2.7H5.1zM9.1 6.2h3.1v2.7H9.1zM13.1 6.2h3.1v2.7h-3.1z"/></g>}
    {icon === 'proxmox' && <g fill="#e57000" stroke="none"><path d="M4 3.5h6.1a5.2 5.2 0 0 1 0 10.4H7.2v6.6H4V3.5Zm3.2 3.2v4h2.8a2 2 0 0 0 0-4H7.2Z"/><path d="m14.5 13.3 2.5-2.5 2.5 2.5-2.5 2.5-2.5-2.5Z"/></g>}
    {icon === 'vmware' && <g fill="#607078" stroke="none"><path d="M2.5 6.2h4.1l2.6 8.2 2.7-8.2H16l-4.7 12.1H8.3L2.5 6.2Z"/><path d="M14.2 6.2h2.9c2.7 0 4.4 1.5 4.4 3.7 0 2.3-1.7 3.7-4.4 3.7h-1.1v-2.5h.8c1 0 1.7-.4 1.7-1.2s-.7-1.2-1.7-1.2h-2.6V6.2Z"/></g>}
    {icon === 'gitlab' && <g fill="#fc6d26" stroke="none"><path d="m12 20.8-3.8-3.5-5.1-4.8 2-6.2c.2-.7 1.2-.7 1.4 0L8 11.4h8l1.5-5.1c.2-.7 1.2-.7 1.4 0l2 6.2-5.1 4.8-3.8 3.5Z"/><path fill="#e24329" d="m12 20.8-4-9.4h8l-4 9.4Z"/><path fill="#fca326" d="m3.1 12.5 4.9-1.1 4 9.4-8.9-8.3Z"/></g>}
    {icon === 'linux' && <g stroke="none"><path fill="#2f2f2f" d="M12 3.2c-2.5 0-4 2.6-4 5.6 0 1.8-.8 2.7-1.8 4.2-1.2 1.8-.5 3.7 1.4 3.8 1.4.1 2.5-.8 3.4-.6.8.2.6 1.5 2.5 1.5s1.7-1.3 2.5-1.5c.9-.2 2 .7 3.4.6 1.9-.1 2.6-2 1.4-3.8-1-1.5-1.8-2.4-1.8-4.2 0-3-1.5-5.6-4-5.6Z"/><path fill="#f6c945" d="M9.2 18.2c.8-1.3 1.7-2 2.8-2s2 .7 2.8 2c-.8.8-1.7 1.2-2.8 1.2s-2-.4-2.8-1.2ZM9.5 12.2c.9.6 1.5.8 2.5.8s1.6-.2 2.5-.8c-.2 1.8-1.2 2.7-2.5 2.7s-2.3-.9-2.5-2.7Z"/><circle cx="10" cy="9.2" r=".7" fill="#fff"/><circle cx="14" cy="9.2" r=".7" fill="#fff"/></g>}
    {icon === 'bash' && <g fill="#4eaa25" stroke="none"><path d="M4 4h16v16H4z"/><path fill="#fff" d="m7 8 3 3-3 3 1.1 1.1 4.1-4.1-4.1-4.1L7 8ZM13 15h4v1.5h-4z"/></g>}
    {icon === 'python' && <><path fill="#3776ab" stroke="none" d="M11.8 2.5c-3.7 0-3.5 1.6-3.5 1.6v2.2h3.6v.7H6.8c-3.7 0-3.6 3.3-3.6 3.3v2.8c0 3.4 3.3 3.3 3.3 3.3h1.9v-2.5s-.1-3.3 3.3-3.3h3.6s3.2.1 3.2-3V5.9s.5-3.4-3.2-3.4h-3.5Zm-2 .9c.4 0 .7.3.7.7s-.3.7-.7.7-.7-.3-.7-.7.3-.7.7-.7Z"/><path fill="#ffd343" stroke="none" d="M12.2 21.5c3.7 0 3.5-1.6 3.5-1.6v-2.2h-3.6V17h5.1c3.7 0 3.6-3.3 3.6-3.3v-2.8c0-3.4-3.3-3.3-3.3-3.3h-1.9v2.5s.1 3.3-3.3 3.3H8.7s-3.2-.1-3.2 3v1.7s-.5 3.4 3.2 3.4h3.5Zm2-.9c-.4 0-.7-.3-.7-.7s.3-.7.7-.7.7.3.7.7-.3.7-.7.7Z"/></>}
    {icon === 'go' && <g fill="#00add8" stroke="none"><path d="M3.2 9.1c.7-1.1 1.8-1.7 3.2-1.7h8.3c1.1 0 2 .3 2.8.9l1.2-1.1 1.3 1.4-1.3 1.2c.3.6.5 1.2.5 2 0 2.5-1.8 4-4.5 4H9.2c-.7 0-1.2.4-1.2 1s.5 1 1.2 1h4.5v2.2H8.8c-2 0-3.3-1.2-3.3-3.1 0-1.2.5-2.1 1.4-2.7-1.8-.2-3.1-1.2-3.7-2.8Zm6.1.5c-.8 0-1.4.5-1.4 1.2s.6 1.2 1.4 1.2h5.2c.8 0 1.4-.5 1.4-1.2s-.6-1.2-1.4-1.2H9.3Z"/><path d="M10.2 18.1h2.5v2.2h-2.5z"/></g>}
    {icon === 'podman' && <g fill="#892ca0" stroke="none"><path d="M5 8.2h14v8.1c0 2.1-1.7 3.7-3.7 3.7H8.7C6.7 20 5 18.4 5 16.3V8.2Z"/><path d="M7.5 8.2V5.9h2.1v2.3h4.8V5.9h2.1v2.3h1.4l1.2-2.1 1.2.7-1.2 2.1v1.7H7.5Z"/><circle cx="9.5" cy="13" r="1" fill="#fff"/><circle cx="14.5" cy="13" r="1" fill="#fff"/><path d="M9.5 16.1h5" stroke="#fff" stroke-width="1.2" stroke-linecap="round"/></g>}
    {icon === 'ansible' && <g fill="#ee0000" stroke="none"><path d="m12 2.8 9 18.4h-4.1l-2-4.2H9.1l-2 4.2H3L12 2.8Zm0 6.5-1.7 4.2h3.4L12 9.3Z"/></g>}
    {icon === 'networking' && <g fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="5" r="2"/><circle cx="5" cy="18" r="2"/><circle cx="19" cy="18" r="2"/><path d="m11 7-5 9M13 7l5 9M7 18h10"/></g>}
  </svg>
  {name}
</span>
