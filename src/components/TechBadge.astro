---
import {
  siAnsible,
  siDocker,
  siGitlab,
  siGo,
  siGnubash,
  siKubernetes,
  siLinux,
  siPodman,
  siProxmox,
  siPython,
  siVmware,
} from 'simple-icons';

interface Props { name: string; }
const { name } = Astro.props;
const iconByTechnology = {
  Kubernetes: siKubernetes,
  Docker: siDocker,
  'Proxmox VE': siProxmox,
  VMware: siVmware,
  'GitLab CI/CD': siGitlab,
  Linux: siLinux,
  Bash: siGnubash,
  Python: siPython,
  Go: siGo,
  Podman: siPodman,
  Ansible: siAnsible,
} as const;
const icon = iconByTechnology[name as keyof typeof iconByTechnology];
---
<span class="inline-flex items-center gap-2 rounded-md border border-stone-200 bg-white px-3 py-2 font-mono text-sm text-stone-700 dark:border-emerald-950 dark:bg-[#0b1410] dark:text-emerald-100">
  <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    {icon ? <path fill={`#${icon.hex}`} d={icon.path} /> : <g fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="5" r="2"/><circle cx="5" cy="18" r="2"/><circle cx="19" cy="18" r="2"/><path d="m11 7-5 9M13 7l5 9M7 18h10"/></g>}
  </svg>
  {name}
</span>
