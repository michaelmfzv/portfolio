---
interface Props { company: string; }
const { company } = Astro.props;
const icon = company === 'PuntoCom SRL' ? 'shell' : company === 'Xerobol S.A.' ? 'camera' : 'support';
---
<svg class="block h-4 w-4 shrink-0 text-accent dark:text-terminal" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    {icon === 'shell' && <><rect x="3" y="4" width="18" height="16" rx="2"/><path d="m7 9 3 3-3 3M13 15h4"/></>}
    {icon === 'camera' && <><path d="M4 8.5h11.5a4.5 4.5 0 0 1 4.5 4.5v2.5H4z"/><path d="m4 8.5 2.2-3h4.6l2.2 3M20 12.5l2 1.2v3.1l-2 1.2"/><circle cx="10" cy="13.5" r="2.4"/></>}
    {icon === 'support' && <><path d="M4 13a8 8 0 0 1 16 0"/><path d="M4 13v3a2 2 0 0 0 2 2h1v-6H6a2 2 0 0 0-2 2ZM20 13v3a2 2 0 0 1-2 2h-1v-6h1a2 2 0 0 1 2 2Z"/><path d="M15 19c-.7 1-1.8 1.5-3 1.5h-1"/></>}
</svg>
