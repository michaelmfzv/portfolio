---
import Layout from '../layouts/Layout.astro';
import TechBadge from './TechBadge.astro';
import ShowcaseCard from './ShowcaseCard.astro';
import { ui, roleTitles, localizedPath, type Language } from '../i18n/ui';
import { experience, technologies, site } from '../data/site';
interface Work { id: string; data: { title: string; description: string; tags: string[]; cover?: string; }; }
interface Props { lang: Language; guides: Work[]; }
const { lang, guides } = Astro.props;
const t = ui[lang];
const roles = roleTitles[lang];
const nameParts = site.name.split(' ');
const givenNames = nameParts.slice(0, 2).join(' ');
const familyNames = nameParts.slice(2).join(' ');
const mobileName = `${nameParts[0]} ${nameParts[2]}`;
const cvHref = `/cv/michael-zapata-cv-${lang}.pdf`;
const casePath = lang === 'es' ? 'casos-de-estudio' : lang === 'en' ? 'case-studies' : 'etudes-de-cas';
const guideUrl = (id: string) => localizedPath(lang, `${casePath}/${id.split('/').at(-1)}`);
const experienceUrl = localizedPath(lang, lang === 'es' ? 'experiencia' : 'experience');
const experienceId = (company: string) => company.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
---
<Layout lang={lang} title={`${site.name} — ${t.role}`} description={`${t.intro} ${t.intro2}`}>
  <div class="section-shell">
    <section class="grid min-h-[560px] items-center gap-12 py-20 md:grid-cols-[1.4fr_0.6fr] md:py-28" aria-labelledby="hero-title">
      <div>
        <div class="flex items-center gap-5 sm:gap-7">
          <div class="flex h-36 w-36 shrink-0 items-center justify-center overflow-hidden rounded-full border border-stone-300 bg-stone-200 font-mono text-xl text-stone-500 dark:border-emerald-900 dark:bg-emerald-950 dark:text-emerald-200 sm:h-40 sm:w-40" aria-label={lang === 'es' ? 'Foto de Michael Zapata' : lang === 'en' ? 'Photo of Michael Zapata' : 'Photo de Michael Zapata'}>
            <span data-profile-fallback aria-hidden="true">MZ</span>
            <img data-profile-image src="/images/profile.png" alt="Michael Zapata" class="hidden h-full w-full object-cover" width="128" height="128" />
          </div>
          <h1 id="hero-title" class="min-w-0 text-3xl font-semibold leading-[1.05] tracking-[-0.045em] sm:text-5xl xl:text-6xl"><span class="block lg:hidden">{mobileName}</span><span class="hidden lg:block">{givenNames}</span><span class="hidden lg:block">{familyNames}</span></h1>
        </div>
        <p class="mt-5 min-h-[1.75em] font-mono text-base text-accent sm:text-lg dark:text-terminal" aria-label={roles.join(', ')}>
          <span aria-hidden="true" class="mr-2">$</span><span data-role-text aria-hidden="true">{roles[0]}</span><span aria-hidden="true" class="ml-0.5 animate-pulse">▍</span>
        </p>
        <div class="mt-7 max-w-2xl space-y-2 text-lg leading-8 text-stone-600 dark:text-stone-300">
          <p>{t.intro}</p><p>{t.intro2}</p>
        </div>
        <ul class="mt-8 flex flex-wrap gap-3" aria-label={lang === 'es' ? 'Enlaces principales' : lang === 'en' ? 'Quick links' : 'Liens principaux'}>
          <li>
            <a class="inline-flex items-center gap-2 rounded-md border border-stone-300 px-4 py-2.5 text-sm font-medium text-stone-700 transition-colors hover:border-accent hover:text-accent dark:border-emerald-900 dark:text-emerald-100 dark:hover:border-terminal dark:hover:text-terminal" href={site.linkedin} target="_blank" rel="noreferrer">
              <svg class="h-4 w-4 shrink-0 text-[#0a66c2] dark:text-[#70b7ff]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.13 1.45-2.13 2.94v5.67H9.35V9h3.42v1.56h.05a3.75 3.75 0 0 1 3.37-1.85c3.6 0 4.26 2.37 4.26 5.45v6.29ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0Z"/></svg>
              LinkedIn
            </a>
          </li>
          <li>
            <a class="inline-flex items-center gap-2 rounded-md border border-stone-300 px-4 py-2.5 text-sm font-medium text-stone-700 transition-colors hover:border-accent hover:text-accent dark:border-emerald-900 dark:text-emerald-100 dark:hover:border-terminal dark:hover:text-terminal" href={`mailto:${site.email}`}>
              <svg class="h-4 w-4 shrink-0 text-accent dark:text-terminal" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m4 7 8 6 8-6"/></svg>
              {t.emailLabel}
            </a>
          </li>
          <li>
            <button type="button" data-cv-open data-cv-url={cvHref} aria-haspopup="dialog" aria-controls="cv-preview-dialog" class="inline-flex items-center gap-2 rounded-md border border-stone-300 px-4 py-2.5 text-sm font-medium text-stone-700 transition-colors hover:border-accent hover:text-accent dark:border-emerald-900 dark:text-emerald-100 dark:hover:border-terminal dark:hover:text-terminal">
              <svg class="h-4 w-4 shrink-0 text-accent dark:text-terminal" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 3.75h9l5 5v11.5H5z"/><path d="M14 3.75v5h5M8 13h8M8 16.5h6"/></svg>
              {t.viewCv}
            </button>
          </li>
        </ul>
      </div>
      <div class="surface hidden rounded-lg p-6 font-mono text-xs leading-6 text-stone-500 md:block dark:text-emerald-100/70" aria-hidden="true">
        <div class="mb-5 flex gap-1.5"><i class="h-2 w-2 rounded-full bg-red-400"></i><i class="h-2 w-2 rounded-full bg-amber-400"></i><i class="h-2 w-2 rounded-full bg-emerald-500"></i></div>
        <p><span class="text-accent dark:text-terminal">$</span> whoami</p><p class="text-ink dark:text-emerald-50">sysadmin · devops</p>
        <p class="mt-4"><span class="text-accent dark:text-terminal">$</span> systemctl status availability</p>
        <p class="text-emerald-700 dark:text-terminal">● design: deliberate</p><p class="text-emerald-700 dark:text-terminal">● operations: observable</p><p class="text-emerald-700 dark:text-terminal">● changes: reproducible</p>
        <p class="mt-4"><span class="text-accent dark:text-terminal">$</span> <span class="animate-pulse">▍</span></p>
      </div>
    </section>

    <section id="technologies" class="scroll-mt-10 border-t border-stone-200 py-16 dark:border-emerald-950" aria-labelledby="technologies-title">
      <div class="mb-7"><p class="eyebrow">01 / technologies</p><h2 id="technologies-title" class="mt-2 text-2xl font-semibold">{t.technologies}</h2><p class="mt-2 text-sm text-stone-600 dark:text-stone-300">{t.technologiesNote}</p></div>
      <ul class="flex flex-wrap gap-3">{technologies.map((name) => <li><TechBadge name={name} /></li>)}</ul>
    </section>

    <section id="experience" class="scroll-mt-10 border-t border-stone-200 py-16 dark:border-emerald-950" aria-labelledby="experience-title">
      <div class="mb-8 flex flex-col justify-between gap-3 sm:flex-row sm:items-end"><div><p class="eyebrow">02 / experience</p><h2 id="experience-title" class="mt-2 text-2xl font-semibold">{t.experience}</h2></div><p class="max-w-xl text-sm leading-6 text-stone-600 dark:text-stone-300">{t.experienceNote}</p></div>
      <div class="grid gap-5 md:grid-cols-3">
        {experience[lang].map((job) => <a href={`${experienceUrl}#${experienceId(job.company)}`} class="group flex h-full flex-col rounded-lg border border-stone-200 bg-white/60 p-5 transition-colors hover:border-accent/60 hover:bg-white dark:border-emerald-950 dark:bg-[#0d1713]/60 dark:hover:border-terminal/60 dark:hover:bg-[#0d1713]">
          <div class="flex flex-col justify-between gap-2"><h3 class="text-lg font-semibold group-hover:text-accent dark:group-hover:text-terminal">{job.role}</h3><p class="font-mono text-xs text-stone-500 dark:text-emerald-200/70">{job.period}</p></div>
          <p class="mt-2 text-sm font-medium text-accent dark:text-terminal">{job.company}</p>
          <p class="mt-1 text-xs text-stone-500 dark:text-stone-400">{job.location}</p>
          <p class="mt-4 flex-1 text-sm leading-6 text-stone-600 dark:text-stone-300">{job.summary}</p>
          <span class="mt-5 text-xs font-medium text-stone-500 transition-colors group-hover:text-accent dark:text-stone-400 dark:group-hover:text-terminal">{t.viewExperience} →</span>
        </a>)}
      </div>
    </section>

    <section id="showcases" class="scroll-mt-10 border-t border-stone-200 py-16 dark:border-emerald-950" aria-labelledby="work-title">
      <div class="mb-8 flex flex-col justify-between gap-3 sm:flex-row sm:items-end"><div><p class="eyebrow">03 / case studies</p><h2 id="work-title" class="mt-2 text-2xl font-semibold">{t.work}</h2></div><p class="max-w-xl text-sm leading-6 text-stone-600 dark:text-stone-300">{t.workNote}</p></div>
      {guides.length ? <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">{guides.map((guide) => <ShowcaseCard title={guide.data.title} description={guide.data.description} href={guideUrl(guide.id)} cover={guide.data.cover} tags={guide.data.tags} label={t.draftLabel} />)}</div> : <p class="text-sm text-stone-600 dark:text-stone-300">{t.empty}</p>}
    </section>

    <section class="grid gap-8 border-t border-stone-200 py-16 md:grid-cols-2 dark:border-emerald-950" aria-labelledby="about-title">
      <div><p class="eyebrow">04 / method</p><h2 id="about-title" class="mt-2 text-2xl font-semibold">{t.about}</h2></div>
      <p class="max-w-2xl text-base leading-7 text-stone-600 dark:text-stone-300">{t.aboutText}</p>
    </section>

    <section id="contact" class="mb-16 scroll-mt-10 rounded-lg bg-[#e9efea] p-7 sm:p-10 dark:bg-[#101c16]" aria-labelledby="contact-title">
      <p class="eyebrow">05 / contact</p><h2 id="contact-title" class="mt-2 text-2xl font-semibold">{t.contact}</h2><p class="mt-2 text-sm text-stone-600 dark:text-stone-300">{t.contactNote}</p>
      <ul class="mt-6 flex flex-wrap gap-3">
        <li><a class="inline-flex rounded border border-stone-300 px-4 py-2 text-sm hover:border-accent hover:text-accent dark:border-emerald-900 dark:hover:border-terminal dark:hover:text-terminal" href={site.linkedin} target="_blank" rel="noreferrer">LinkedIn ↗</a></li>
        {site.github && <li><a class="inline-flex rounded border border-stone-300 px-4 py-2 text-sm hover:border-accent dark:border-emerald-900" href={site.github} target="_blank" rel="noreferrer">GitHub ↗</a></li>}
        <li><a class="inline-flex rounded border border-stone-300 px-4 py-2 text-sm hover:border-accent dark:border-emerald-900" href={`mailto:${site.email}`}>{site.email}</a></li>
      </ul>
    </section>
  </div>

  <dialog id="cv-preview-dialog" class="m-auto h-[min(92dvh,900px)] max-h-[92dvh] w-[min(960px,calc(100%-2rem))] max-w-none overflow-hidden rounded-lg border border-stone-200 bg-paper p-0 text-ink shadow-2xl backdrop:bg-black/70 dark:border-emerald-900 dark:bg-[#0d1713] dark:text-stone-100">
    <div class="flex h-full flex-col">
      <div class="flex items-center justify-between gap-4 border-b border-stone-200 px-4 py-3 dark:border-emerald-950">
        <h2 class="text-sm font-semibold">{t.cvPreviewTitle} · {site.name}</h2>
        <button type="button" data-cv-close class="rounded-md border border-stone-300 px-3 py-1.5 text-sm hover:border-accent hover:text-accent dark:border-emerald-900 dark:hover:border-terminal dark:hover:text-terminal">{t.cvClose}</button>
      </div>
      <iframe src={cvHref} title={t.cvPreviewTitle} class="min-h-0 flex-1 bg-white"></iframe>
      <div class="flex flex-wrap justify-end gap-3 border-t border-stone-200 px-4 py-3 dark:border-emerald-950">
        <a href={cvHref} target="_blank" rel="noreferrer" class="rounded-md border border-stone-300 px-4 py-2 text-sm hover:border-accent hover:text-accent dark:border-emerald-900 dark:hover:border-terminal dark:hover:text-terminal">{t.cvOpenNewTab}</a>
        <a href={cvHref} download class="rounded-md bg-ink px-4 py-2 text-sm font-medium text-white hover:bg-accent dark:bg-terminal dark:text-[#07100b] dark:hover:bg-emerald-200">{t.downloadCv}</a>
      </div>
    </div>
  </dialog>
</Layout>

<script>
  const cvDialog = document.querySelector<HTMLDialogElement>('#cv-preview-dialog');
  document.querySelectorAll<HTMLButtonElement>('[data-cv-open]').forEach((button) => {
    button.addEventListener('click', () => {
      const cvUrl = button.dataset.cvUrl;
      if (window.matchMedia('(max-width: 767px)').matches && cvUrl) {
        // En móviles dejamos que el navegador abra el PDF en su visor nativo.
        window.location.assign(cvUrl);
        return;
      }
      cvDialog?.showModal();
    });
  });
  document.querySelector('[data-cv-close]')?.addEventListener('click', () => cvDialog?.close());
  cvDialog?.addEventListener('click', (event) => {
    if (event.target === cvDialog) cvDialog.close();
  });

  // Escribe y borra cada cargo como en una consola. El texto inicial queda
  // disponible si JavaScript está desactivado y la animación respeta reduced motion.
  const roleElement = document.querySelector<HTMLElement>('[data-role-text]');
  const profileImage = document.querySelector<HTMLImageElement>('[data-profile-image]');
  const profileFallback = document.querySelector<HTMLElement>('[data-profile-fallback]');

  if (profileImage && profileFallback) {
    const showProfile = () => {
      profileImage.classList.remove('hidden');
      profileFallback.classList.add('hidden');
    };
    profileImage.addEventListener('load', showProfile, { once: true });
    profileImage.addEventListener('error', () => profileImage.classList.add('hidden'), { once: true });
    if (profileImage.complete && profileImage.naturalWidth > 0) showProfile();
  }

  if (roleElement) {
    const roles = (roleElement.closest('[aria-label]')?.getAttribute('aria-label') ?? '').split(', ');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!reducedMotion && roles.length > 1) {
      let roleIndex = 0;
      let letterIndex = roles[0].length;
      let deleting = true;

      const typeNextCharacter = () => {
        const currentRole = roles[roleIndex];
        roleElement.textContent = currentRole.slice(0, letterIndex);

        if (!deleting && letterIndex < currentRole.length) {
          letterIndex++;
          window.setTimeout(typeNextCharacter, 75);
        } else if (!deleting) {
          deleting = true;
          window.setTimeout(typeNextCharacter, 1500);
        } else if (letterIndex > 0) {
          letterIndex--;
          window.setTimeout(typeNextCharacter, 38);
        } else {
          deleting = false;
          roleIndex = (roleIndex + 1) % roles.length;
          window.setTimeout(typeNextCharacter, 300);
        }
      };

      window.setTimeout(typeNextCharacter, 1500);
    }
  }
</script>
